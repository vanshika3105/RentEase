# Copy this file to .env.local and enter the Firebase web app config from
# Firebase Console > Project settings > Your apps. Do not commit .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Leave empty to use the Vite proxy (/api -> http://localhost:5000)
VITE_API_URL=
